    "backend_bound": "slots left empty because the backend was full (waiting on memory or execution resources)",
    "retiring": "slots used by ops that retired: useful work",
    "backend_memory": "backend_bound share while the oldest op is a load",
    "frontend_latency": "frontend_bound share in cycles with no ops at all (fetch latency: i-cache/iTLB misses, redirects)"
